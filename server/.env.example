# ==============================================================================
# 🌾 KisanSetu — Server Environment Configuration Template
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=development
JWT_SECRET=supersecretjwtkeyforfarmersforus2026_change_in_production

# Database Configuration:
# - Leave blank to use local zero-setup SQLite (server/data/marketplace.db)
# - In Production: Set Neon PostgreSQL connection string:
# DATABASE_URL=postgresql://neondb_owner:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Telephony & Voice AI (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Public Tunnel / Domain URL (for Twilio Webhooks & Audio callbacks)
# Local development: https://your-tunnel.lhr.life
# Production: https://kisansetu.onrender.com
PUBLIC_URL=http://localhost:5000

# Sarvam AI (Indian Language TTS/STT)
SARVAM_API_KEY=your_sarvam_api_key

# Payment Gateway (Razorpay Test Mode - ₹0 Cost)
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# AI Python Microservice Proxy
AI_SERVICE_URL=http://127.0.0.1:5001

# Debugging flags
DEBUG_SQL=false
